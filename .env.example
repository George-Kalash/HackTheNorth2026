# Local zero-service mode; use PostgreSQL URL for the compose database.
PT_DATABASE_URL=sqlite:///./data/terminal.db
# PT_DATABASE_URL=postgresql+psycopg://terminal:terminal@localhost:5432/terminal
PT_POLL_SECONDS=15
PT_MAX_AGE_SECONDS=45
PT_MAX_SKEW_SECONDS=20
PT_REQUESTS_PER_SECOND=3
PT_RETENTION_DAYS=7
PT_KALSHI_API_KEY_ID=
PT_KALSHI_PRIVATE_KEY_PATH=
